POSTGRES_DB=vsrala
POSTGRES_USER=vsrala
POSTGRES_PASSWORD=vsrala
POSTGRES_HOST=database
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Django
DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
# CSRF_TRUSTED_ORIGINS дополняется автоматически из DOMAIN;
# при необходимости можно задать вручную через запятую:
# CSRF_TRUSTED_ORIGINS=https://example.com

# Домен и TLS (для локальной разработки оставьте ENABLE_SSL=0)
DOMAIN=localhost
CERTBOT_EMAIL=admin@example.com
ENABLE_SSL=0
